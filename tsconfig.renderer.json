{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "resolveJsonModule": true, "noUnusedLocals": false,
    "types": ["vite/client"]
  },
  "include": ["src/renderer", "src/shared", "third_party/summa-ui/src"]
}
