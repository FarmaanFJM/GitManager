{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/schema/checks.schema.json",
  "title": "Summa-UI check rules for automated evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "report", "checks", "humanJudgment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "report": {
      "type": "object", "additionalProperties": false, "required": ["statuses", "findingFields"],
      "properties": { "statuses": { "type": "array", "items": { "enum": ["pass", "fail", "needs-human", "not-applicable"] } }, "findingFields": { "type": "array", "items": { "type": "string" } } }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "principles", "automation", "kind", "severity", "description", "procedure", "exceptions"],
        "properties": {
          "id": { "type": "string", "pattern": "^CHK-\\d{3}$" },
          "title": { "type": "string" },
          "antipattern": { "type": "string", "pattern": "^AP-\\d{3}$" },
          "principles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P\\d{2}$" } },
          "automation": { "enum": ["objective", "heuristic"], "description": "objective: deterministic pass/fail. heuristic: automated signal that may need human confirmation (reports needs-human)." },
          "kind": { "enum": ["source-text", "source-css", "dom-computed-style", "dom-structure", "viewport-layout", "contrast"] },
          "severity": { "enum": ["error", "warning"] },
          "description": { "type": "string" },
          "procedure": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Deterministic steps an evaluator implements." },
          "thresholds": { "type": "object" },
          "patterns": { "type": "array", "items": { "type": "string" }, "description": "Regular expressions (ECMAScript source, no inline flags) used by the procedure." },
          "patternFlags": { "type": "string", "pattern": "^[gimsuy]*$", "description": "Flags applied to every pattern, for example i." },
          "exceptions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "humanJudgment": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "question", "principles"], "properties": { "id": { "type": "string", "pattern": "^HJ-\\d{3}$" }, "question": { "type": "string" }, "principles": { "type": "array", "items": { "type": "string", "pattern": "^P\\d{2}$" } } } }
    }
  }
}
