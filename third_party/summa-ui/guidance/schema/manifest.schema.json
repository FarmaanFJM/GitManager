{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/schema/manifest.schema.json",
  "title": "Summa-UI guidance bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "channel",
    "reviewedBy",
    "files",
    "entrypoints",
    "counts",
    "compat"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "summa-ui-guidance"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$"
    },
    "channel": {
      "enum": [
        "draft",
        "candidate",
        "approved"
      ],
      "description": "Only 'approved' bundles may be pinned by the Orchestrator."
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human approver. null while draft."
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer"
          },
          "role": {
            "enum": [
              "principles",
              "antipatterns",
              "presets",
              "tokens",
              "icons",
              "checks",
              "examples",
              "css",
              "docs",
              "schema"
            ]
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principles",
        "antipatterns",
        "presets",
        "tokens",
        "icons",
        "checks"
      ],
      "properties": {
        "principles": {
          "type": "string"
        },
        "antipatterns": {
          "type": "string"
        },
        "presets": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        },
        "icons": {
          "type": "string"
        },
        "checks": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 over the sorted 'path:sha256' lines of files. Pin this value."
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworkAgnostic",
        "optionalReference"
      ],
      "properties": {
        "frameworkAgnostic": {
          "const": true
        },
        "optionalReference": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approvalRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisional": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^preset\\.[a-z-]+$"
      },
      "description": "Presets in this bundle whose visual design is not yet reviewed by the owner."
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
