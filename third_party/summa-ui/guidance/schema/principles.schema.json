{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/schema/principles.schema.json",
  "title": "Summa-UI principles (machine form of PRINCIPLES.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "principles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "PRINCIPLES.md" },
    "principles": {
      "type": "array", "minItems": 22,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "number", "title", "slug", "antipatterns", "summary", "rules", "exceptions"],
        "properties": {
          "id": { "type": "string", "pattern": "^P\\d{2}$" }, "number": { "type": "integer" }, "title": { "type": "string" }, "slug": { "type": "string" },
          "antipatterns": { "type": "array", "items": { "type": "string", "pattern": "^AP-\\d{3}$" } },
          "summary": { "type": "string" }, "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "exceptions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
