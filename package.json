{
  "name": "gitmanager",
  "productName": "GitManager",
  "version": "0.1.0",
  "description": "Desktop workspace for managing local Git repositories and launching development services. Built with Summa-UI.",
  "license": "MIT",
  "author": "FarmaanFJM",
  "repository": {
    "type": "git",
    "url": "https://github.com/FarmaanFJM/GitManager.git"
  },
  "main": "dist/main/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "verify:summa-ui": "node scripts/summa-ui/verify-vendored.mjs third_party/summa-ui/guidance summa-ui.lock.json && node scripts/summa-ui/verify-reference.mjs summa-ui.lock.json",
    "record:usage": "node scripts/summa-ui/record-guidance-usage.mjs --app gitmanager --lock summa-ui.lock.json --repository https://github.com/FarmaanFJM/GitManager --out summa-ui.usage.json",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.farmaanfjm.gitmanager",
    "productName": "GitManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GitManager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
